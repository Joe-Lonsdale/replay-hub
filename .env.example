APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
STEAM_API_KEY=

# Neon, or any Postgres. Leave empty locally and the app uses a database in data/pglite.
DATABASE_URL=

# Cloudflare R2. Leave empty locally and replay files stay in data/replays.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=replay-lab

# Optional server-side RLAPI sync. Use either an EOS token flow or an already-authenticated PsyNet session.
# The build values change after Rocket League updates; defaults are embedded but can be overridden here.
RLAPI_PLATFORM=Epic
RLAPI_ACCOUNT_ID=
RLAPI_PLAYER_ID=
RLAPI_EOS_TOKEN=
RLAPI_EPIC_ACCOUNT_ID=
RLAPI_ACCOUNT_NAME=
RLAPI_GAME_VERSION=
RLAPI_FEATURE_SET=
RLAPI_BUILD_SECRET=
RLAPI_BUILD_ID=

# Alternative to EOS auth if you already have PsyNet websocket session credentials.
RLAPI_WS_URL=
RLAPI_PSY_TOKEN=
RLAPI_SESSION_ID=
