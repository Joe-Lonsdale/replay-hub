APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
STEAM_API_KEY=

# Neon, or any Postgres. Leave empty locally and the app uses a database in data/pglite.
DATABASE_URL=

# Cloudflare R2. Leave empty locally and replay files stay in data/replays.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=replay-lab
